# Google Gemini API Key (for Live AI DNA Card Extraction, Gap Analysis, Semantic Search)
# Get a free key at: https://aistudio.google.com/app/apikey
NEXT_PUBLIC_GEMINI_API_KEY=
GEMINI_API_KEY=

# Supabase Configuration
# Create a free project at: https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App Environment
NEXT_PUBLIC_APP_NAME="DNA Platform"
NEXT_PUBLIC_APP_DESCRIPTION="An Intelligent Platform for Discovering, Connecting, and Extending Student Projects"
